# Copy this file to .env and fill in real values. Never commit .env.

# Gemini via Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-ai-studio-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.8-flash

# Private Google Cloud Storage bucket (not needed with --local-only)
GCS_BUCKET=your-bucket-name
# Optional: the project that owns the bucket
GOOGLE_CLOUD_PROJECT=

# Optional: free CoinGecko Demo API key. Leave empty to use the keyless endpoint.
COINGECKO_API_KEY=

# Optional: set to "local" to always skip GCS (same as python main.py --local-only)
STORAGE_MODE=gcs
